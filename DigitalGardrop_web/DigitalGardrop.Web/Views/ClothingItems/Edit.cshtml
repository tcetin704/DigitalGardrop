
@model DigitalGardrop.Web.Models.ClothingItemFormViewModel

@{
    ViewData["Title"] = "Kıyafet Düzenle";
}

<div class="container mt-5">

    <h2>Kıyafet Düzenle</h2>

    <p class="text-muted">
        Kıyafet bilgilerini güncelle.
    </p>

    <form asp-controller="ClothingItems"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post" enctype="multipart/form-data">

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId"
                   class="form-label"></label>

            <select asp-for="CategoryId"
                    asp-items="Model.Categories"
                    class="form-select">
                <option value="">Kategori seçiniz</option>
            </select>

            <span asp-validation-for="CategoryId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Color" class="form-label"></label>
            <input asp-for="Color" class="form-control" />
            <span asp-validation-for="Color"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Season" class="form-label"></label>

            <select asp-for="Season" class="form-select">
                <option value="">Mevsim seçiniz</option>
                <option value="İlkbahar">İlkbahar</option>
                <option value="Yaz">Yaz</option>
                <option value="Sonbahar">Sonbahar</option>
                <option value="Kış">Kış</option>
                <option value="Dört Mevsim">Dört Mevsim</option>
            </select>

            <span asp-validation-for="Season"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Style" class="form-label"></label>

            <select asp-for="Style" class="form-select">
                <option value="">Stil seçiniz</option>
                <option value="Günlük">Günlük</option>
                <option value="Spor">Spor</option>
                <option value="Klasik">Klasik</option>
                <option value="Resmi">Resmi</option>
            </select>

            <span asp-validation-for="Style"
                  class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ImageFile" class="form-label fw-semibold"></label>
            <input asp-for="ImageFile" type="file" class="form-control"
                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                   data-photo-preview="clothingPreview" />
            <div class="form-text">Yeni fotoğraf seçersen eskisinin yerine geçer. En fazla 5 MB.</div>
            <span asp-validation-for="ImageFile" class="text-danger"></span>
            @if (!string.IsNullOrWhiteSpace(Model.ExistingImageUrl))
            {
                <img id="clothingPreview" src="@Model.ExistingImageUrl"
                     class="upload-preview mt-3" alt="Kıyafetin mevcut fotoğrafı" />
                <div class="form-check mt-2">
                    <input asp-for="RemoveImage" class="form-check-input" />
                    <label asp-for="RemoveImage" class="form-check-label"></label>
                </div>
            }
            else
            {
                <img id="clothingPreview" class="upload-preview d-none mt-3"
                     alt="Kıyafet fotoğrafı önizlemesi" />
            }
        </div>

        <button type="submit" class="btn btn-primary">
            Değişiklikleri Kaydet
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            İptal
        </a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/photo-preview.js" asp-append-version="true"></script>
}
