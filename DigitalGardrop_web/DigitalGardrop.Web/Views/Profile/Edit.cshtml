@model DigitalGardrop.Web.ViewModels.EditProfileViewModel
@{
    ViewData["Title"] = "Profil Düzenle";
}

<div class="profile-page py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <a asp-action="Index" class="text-decoration-none d-inline-block mb-3">← Profilime Dön</a>
            <section class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h3 fw-bold mb-2">Profil Bilgilerini Düzenle</h1>
                    <p class="text-muted mb-4">Kullanıcı adınızı, e-postanızı ve profil fotoğrafınızı güncelleyebilirsiniz.</p>
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="DisplayName" class="form-label fw-semibold"></label>
                            <input asp-for="DisplayName" class="form-control" autocomplete="nickname" />
                            <span asp-validation-for="DisplayName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ProfilePhoto" class="form-label fw-semibold"></label>
                            <input asp-for="ProfilePhoto" type="file" class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                   data-photo-preview="profilePreview" />
                            <div class="form-text">JPG, PNG veya WEBP, en fazla 5 MB. Fotoğraf seçersen URL'nin yerine kullanılır.</div>
                            <span asp-validation-for="ProfilePhoto" class="text-danger small"></span>
                            <img id="profilePreview" class="upload-preview d-none mt-3"
                                 alt="Seçilen profil fotoğrafı önizlemesi" />
                        </div>
                        <div class="mb-4">
                            <label asp-for="ProfileImageUrl" class="form-label fw-semibold"></label>
                            <input asp-for="ProfileImageUrl" class="form-control"
                                   placeholder="https://ornek.com/profil.jpg" />
                            <div class="form-text">İsteğe bağlı HTTPS bağlantısı. Mac'ten fotoğraf seçersen bu alan yok sayılır.</div>
                            <span asp-validation-for="ProfileImageUrl" class="text-danger small"></span>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/photo-preview.js" asp-append-version="true"></script>
}
