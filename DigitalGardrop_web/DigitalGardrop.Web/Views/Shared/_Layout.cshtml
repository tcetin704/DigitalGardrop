
<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Dijital Gardırop</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/DigitalGardrop.Web.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- UYGULAMA BASLIGI -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    Dijital Gardırop
                </a>

                <!-- MOBIL MENU BUTONU -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Menüyü aç">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <!-- SOL MENU -->
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">
                                Ana Sayfa
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="ClothingItems"
                               asp-action="Index">
                                Gardırobum
                            </a>
                        </li>

                    </ul>

                    <!-- SAG MENU / KULLANICI ISLEMLERI -->
                    <ul class="navbar-nav align-items-sm-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- GIRIS YAPMIS KULLANICI -->

                            <li class="nav-item">
                                <span class="nav-link text-dark fw-semibold">
                                    Merhaba, @(User.Identity?.Name)!
                                </span>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <span class="badge bg-primary me-2">
                                        Yönetici
                                    </span>
                                </li>
                            }

                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm">
                                        Çıkış Yap
                                    </button>

                                </form>
                            </li>
                        }
                        else
                        {
                            <!-- GIRIS YAPMAMIS KULLANICI -->

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Giriş Yap
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Kayıt Ol
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <!-- SAYFA ICERIGI -->
    <div class="container">

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    </div>

    <!-- ALT BILGI -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Dijital Gardırop -
            <a asp-controller="Home"
               asp-action="Privacy">
                Gizlilik
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
